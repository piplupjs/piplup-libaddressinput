{
  "name": "piplup-libaddressinput",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless JS/TS port of Google's libaddressinput",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "release": "pnpm run release:prepare && pnpm run release:publish",
    "release:prepare": "node scripts/release.cjs",
    "release:publish": "pnpm -r --filter=./packages/* publish --access public",
    "precommit": "pnpm fmt && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
