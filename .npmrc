# pnpm configuration for workspace protocol and publishing

# Automatically convert workspace:* to version numbers during publish
workspace-root-only=true

# Use exact versions (no ^ or ~ modifiers) when resolving workspace dependencies
resolution-mode=highest

# Include pnpm workspace info in lock file
shamefully-hoist=false

# NPM registry configuration for Trusted Publisher OIDC
registry=https://registry.npmjs.org/

# Publish access level
# Access level is set via CLI during publish: pnpm -r publish --access public
